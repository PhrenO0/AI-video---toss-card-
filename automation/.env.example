# automation/.env 로 복사해서 채워 넣으세요. .env는 커밋되지 않습니다.

# ─── Slack ────────────────────────────────────────────────────────────────
# 정식 경로: Bot User OAuth Token + App-Level Token (Socket Mode)
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
# 폴백 경로: 앱 설치 승인 전 임시로 쓰는 Incoming Webhook (채널 1개 전용)
SLACK_WEBHOOK_URL=
# config/sources.yaml 값을 덮어쓰고 싶을 때
SLACK_DIGEST_CHANNEL=

# ─── X (구 트위터) ────────────────────────────────────────────────────────
# 2026년 기준 신규 개발자에겐 무료 검색 티어가 없습니다. 종량제 또는 아래 폴백 사용.
X_BEARER_TOKEN=
# RSSHub/Nitter 계열 인스턴스 (무료 폴백, 계정 타임라인만 가능)
X_RSS_BASE=

# ─── Meta (Instagram / Threads) ──────────────────────────────────────────
# Instagram: 비즈니스/크리에이터 계정 + 연결된 Facebook 페이지가 필요합니다.
IG_ACCESS_TOKEN=
IG_BUSINESS_USER_ID=
META_GRAPH_VERSION=v22.0
# Threads: threads_keyword_search 권한 승인 전에는 본인 게시물만 검색됩니다.
THREADS_ACCESS_TOKEN=
THREADS_SEARCH_TYPE=TOP
# 공개 검색 결과에는 지표가 없습니다. 자기 게시물 지표까지 받고 싶으면 1로.
THREADS_FETCH_INSIGHTS=0

# ─── Apify (공식 API가 막혔을 때의 폴백 수집) ────────────────────────────
APIFY_TOKEN=
APIFY_X_ACTOR=apidojo~tweet-scraper
APIFY_IG_ACTOR=apify~instagram-scraper
APIFY_THREADS_ACTOR=curious_coder~threads-scraper

# ─── Figma ────────────────────────────────────────────────────────────────
# Settings → Security → Personal access tokens 에서 발급 (file_content: read 이상)
FIGMA_TOKEN=
FIGMA_FILE_KEY=ztuGJQdoVtA7u9pxvq8m4m

# ─── Notion ───────────────────────────────────────────────────────────────
# https://www.notion.so/my-integrations 에서 Internal integration 생성 → 시크릿 복사
# 만든 뒤 대상 DB 페이지에서 ⋯ → 연결(Connections) → 통합 추가 를 꼭 해주세요.
NOTION_TOKEN=ntn_
# 콘텐츠 목록 DB (config/sources.yaml 의 notion.database_id 를 덮어씀)
NOTION_DATABASE_ID=
NOTION_REFERENCE_DATABASE_ID=

# ─── Claude (카드뉴스 카피 생성, 선택) ───────────────────────────────────
# 없으면 규칙 기반 초안으로 자동 폴백합니다.
ANTHROPIC_API_KEY=
